generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PoBatch {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  status          BatchStatus @default(DRAFT)
  dpDeadline      DateTime
  settlementInfo  String?
  products        Product[]
  orders          Order[]
  createdAt       DateTime @default(now())
}

model Product {
  id          String   @id @default(cuid())
  batchId     String
  batch       PoBatch  @relation(fields: [batchId], references: [id])
  name        String
  slug        String
  price       Int
  stock       Int
  sold        Int      @default(0)
  isActive    Boolean  @default(true)
  images      ProductImage[]
  orderItems  OrderItem[]
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  url        String
  order      Int     @default(0)
}

model Order {
  id            String      @id @default(cuid())
  batchId       String
  batch         PoBatch     @relation(fields: [batchId], references: [id])
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  status        OrderStatus @default(PENDING_PAYMENT)
  totalAmount   Int
  dpAmount      Int
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String  // snapshot
  price       Int     // snapshot
  qty         Int
  subtotal    Int
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  midtransOrderId String        @unique
  status          PaymentStatus @default(PENDING)
  amount          Int
  paidAt          DateTime?
}

enum BatchStatus { 
  DRAFT 
  OPEN 
  CLOSED 
  COMPLETED 
}

enum OrderStatus { 
  PENDING_PAYMENT 
  DP_PAID 
  AWAITING_SETTLEMENT 
  COMPLETED 
  CANCELLED 
  EXPIRED 
}

enum PaymentStatus { 
  PENDING 
  SUCCESS 
  FAILED 
  EXPIRED 
}
